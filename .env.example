# JWT
JWT_SECRET=change-me-in-local-env

# Config Server
CONFIG_SERVER_PORT=8888

# Eureka Server
EUREKA_SERVER_PORT=8761
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# API Gateway
API_GATEWAY_PORT=8080

# Auth Service
AUTH_SERVICE_PORT=8081
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3307

# MariaDB Auth Database
MYSQL_ROOT_PASSWORD=root_hotel
MYSQL_DATABASE=db_auth
MYSQL_USER=hotel_user
MYSQL_PASSWORD=hotel_pass

# Room Service
ROOM_SERVICE_PORT=8082
ROOM_DB_HOST=localhost
ROOM_DB_PORT=3308
ROOM_DB_NAME=db_room
ROOM_DB_USER=hotel_user
ROOM_DB_PASSWORD=hotel_pass
ROOM_DB_ROOT_PASSWORD=root_hotel

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
