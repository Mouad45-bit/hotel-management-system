### [13] Filtrer par number=101 (résultat exact)
GET {{baseUrl}}/api/rooms?number=101

> {%
  client.test("[13] Filtre number=101 → 1 résultat exact", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    client.assert(response.body.length === 1, "Exactement 1 chambre");
