### ============================================================
### ROOM-SERVICE — Tests complets (Run All)
### Port : 8082 | Base URL : http://localhost:8082
### Ordre d'exécution : séquentiel, les IDs sont chaînés via
### client.global pour réutilisation dans les appels suivants.
### ============================================================

@baseUrl = http://localhost:8082

# ─────────────────────────────────────────────
# PHASE 0 — SANTÉ
# ─────────────────────────────────────────────

### [01] Ping — health check
GET {{baseUrl}}/api/rooms/ping

> {%
  client.test("[01] Ping répond 200", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
  });
%}




### [02] Créer chambre 101 — DOUBLE / AVAILABLE
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "number": "101",
  "floor": 1,
  "type": "DOUBLE",
  "pricePerNight": 650.00,
  "capacity": 2,
  "status": "AVAILABLE",
  "description": "Chambre double vue jardin"
}

> {%
  client.test("[02] Création 101 → 201 CREATED", function () {
    client.assert(response.status === 201, "Attendu 201 CREATED");
    client.assert(response.body.number === "101", "number doit être 101");
    client.assert(response.body.active === true, "active doit être true");
    client.assert(response.body.createdAt !== null, "createdAt doit être renseigné");
  });
  client.global.set("id101", String(response.body.id));
%}

### [03] Créer chambre 102 — SINGLE / AVAILABLE
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "number": "102",
  "floor": 1,
  "type": "SINGLE",
  "pricePerNight": 350.00,
  "capacity": 1,
  "status": "AVAILABLE",
  "description": "Chambre simple standard"
}

> {%
  client.test("[03] Création 102 → 201 CREATED", function () {
    client.assert(response.status === 201, "Attendu 201 CREATED");
  });
  client.global.set("id102", String(response.body.id));
%}

### [04] Créer chambre 201 — SUITE / MAINTENANCE (prix = 0 autorisé)
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "number": "201",
  "floor": 2,
  "type": "SUITE",
  "pricePerNight": 0.00,
  "capacity": 4,
  "status": "MAINTENANCE",
  "description": "Suite en rénovation — tarif non défini"
}

> {%
  client.test("[04] Création 201 → 201 CREATED (prix=0 accepté)", function () {
    client.assert(response.status === 201, "Attendu 201 CREATED");
    client.assert(response.body.pricePerNight === 0, "prix 0.00 doit être accepté");
  });
  client.global.set("id201", String(response.body.id));
%}

### [05] Créer chambre 301 — FAMILY / OCCUPIED (pour stats)
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "number": "301",
  "floor": 3,
  "type": "FAMILY",
  "pricePerNight": 950.00,
  "capacity": 5,
  "status": "OCCUPIED"
}

> {%
  client.test("[05] Création 301 → 201 CREATED", function () {
    client.assert(response.status === 201, "Attendu 201 CREATED");
  });
  client.global.set("id301", String(response.body.id));
%}

### [06] ERREUR — Numéro de chambre dupliqué → 409 CONFLICT
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "number": "101",
  "floor": 5,
  "type": "DELUXE",
  "pricePerNight": 1200.00,
  "capacity": 2,
  "status": "AVAILABLE"
}

> {%
  client.test("[06] Doublon numéro → 409 CONFLICT", function () {
    client.assert(response.status === 409, "Attendu 409 CONFLICT");
    client.assert(response.body.error === "CONFLICT", "error doit être CONFLICT");
    client.assert(response.body.message.includes("101"), "message doit mentionner le numéro");
    client.assert(response.body.path !== null, "path doit être présent");
  });
%}

### [07] ERREUR — Données invalides → 400 VALIDATION_ERROR
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "number": "",
  "floor": -1,
  "pricePerNight": -50.00,
  "capacity": 0
}

> {%
  client.test("[07] Validation échouée → 400 VALIDATION_ERROR", function () {
    client.assert(response.status === 400, "Attendu 400 BAD_REQUEST");
    client.assert(response.body.error === "VALIDATION_ERROR", "error doit être VALIDATION_ERROR");
    client.assert(response.body.fieldErrors !== null, "fieldErrors doit être présent");
    client.assert(Object.keys(response.body.fieldErrors).length >= 4, "Au moins 4 champs invalides");
  });
%}




### [08] Lister toutes les chambres actives (sans filtre)
GET {{baseUrl}}/api/rooms

> {%
  client.test("[08] Liste chambres actives → 200 OK", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    client.assert(response.body.length >= 4, "Au moins 4 chambres actives");
    response.body.forEach(function (r) {
      client.assert(r.active === true, "Toutes les chambres doivent être actives");
    });
  });
%}

### [09] Filtrer par type=DOUBLE
GET {{baseUrl}}/api/rooms?type=DOUBLE

> {%
  client.test("[09] Filtre type=DOUBLE → 200 OK", function () {
