### [33] Vérifier que 102 apparaît dans /disabled (suppression logique = désactivation)
GET {{baseUrl}}/api/rooms/disabled

> {%
  client.test("[33] Chambre 102 dans /disabled après DELETE", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    var found = response.body.some(function (r) {
      return String(r.id) === client.global.get("id102");
    });
    client.assert(found, "La chambre 102 doit apparaître dans /disabled");
  });
%}

### [34] Stats finales — vérification de cohérence globale
GET {{baseUrl}}/api/rooms/stats

> {%
  client.test("[34] Stats finales → cohérentes", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    var b = response.body;
    var sumStatuses = b.available + b.occupied + b.reserved + b.cleaning + b.maintenance + b.outOfService;
    client.assert(b.total === sumStatuses, "total doit égaler la somme des statuts");
  });
%}
