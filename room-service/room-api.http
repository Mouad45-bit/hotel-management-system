  });
%}

### [14] Filtrer — combinaison type=DOUBLE & floor=1
GET {{baseUrl}}/api/rooms?type=DOUBLE&floor=1

> {%
  client.test("[14] Filtre combiné type=DOUBLE&floor=1 → 200 OK", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    response.body.forEach(function (r) {
      client.assert(r.type === "DOUBLE", "type doit être DOUBLE");
      client.assert(r.floor === 1, "floor doit être 1");
    });
  });
%}

### [15] Obtenir la chambre 101 par ID
GET {{baseUrl}}/api/rooms/{{id101}}

> {%
  client.test("[15] GET /rooms/{id} → 200 OK", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    client.assert(String(response.body.id) === client.global.get("id101"), "ID doit correspondre");
    client.assert(response.body.number === "101", "number doit être 101");
    client.assert(response.body.updatedAt !== null, "updatedAt doit être présent");
  });
%}

### [16] ERREUR — ID inexistant → 404 NOT_FOUND
GET {{baseUrl}}/api/rooms/99999

> {%
  client.test("[16] ID inexistant → 404 NOT_FOUND", function () {
    client.assert(response.status === 404, "Attendu 404 NOT_FOUND");
    client.assert(response.body.error === "NOT_FOUND", "error doit être NOT_FOUND");
    client.assert(response.body.message.includes("99999"), "message doit mentionner l'ID");
  });
%}

### [17] Stats globales
GET {{baseUrl}}/api/rooms/stats

> {%
  client.test("[17] Stats → 200 OK, champs présents", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    client.assert(response.body.total >= 4, "total >= 4");
    client.assert(response.body.available >= 2, "available >= 2");
    client.assert(response.body.occupied >= 1, "occupied >= 1");
    client.assert(response.body.maintenance >= 1, "maintenance >= 1");
    client.assert(typeof response.body.cleaning === "number", "cleaning doit être un nombre");
    client.assert(typeof response.body.reserved === "number", "reserved doit être un nombre");
    client.assert(typeof response.body.outOfService === "number", "outOfService doit être un nombre");
  });
%}




### [18] Modifier la chambre 101 (PUT complet)
PUT {{baseUrl}}/api/rooms/{{id101}}
Content-Type: application/json

{
  "number": "101",
  "floor": 1,
  "type": "DOUBLE",
  "pricePerNight": 750.00,
  "capacity": 3,
  "status": "AVAILABLE",
  "description": "Chambre double rénovée — vue jardin"
}

> {%
  client.test("[18] Mise à jour chambre 101 → 200 OK", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    client.assert(response.body.pricePerNight === 750, "pricePerNight doit être 750");
    client.assert(response.body.capacity === 3, "capacity doit être 3");
    client.assert(response.body.updatedAt !== null, "updatedAt doit être mis à jour");
  });
%}

