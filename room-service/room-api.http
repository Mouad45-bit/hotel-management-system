### [24] Stats après modifications de statut
GET {{baseUrl}}/api/rooms/stats

> {%
  client.test("[24] Stats après modifications → champs cohérents", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    client.assert(response.body.cleaning >= 1, "cleaning >= 1 (chambre 101)");
    client.assert(response.body.reserved >= 1, "reserved >= 1 (chambre 102)");
    client.assert(response.body.outOfService >= 1, "outOfService >= 1 (chambre 201)");
  });
%}




### [25] Désactiver la chambre 301 (deactivate)
PATCH {{baseUrl}}/api/rooms/{{id301}}/deactivate

> {%
  client.test("[25] Désactivation → 200 OK", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
  });
%}

### [26] Vérifier que 301 n'apparaît plus dans la liste active
GET {{baseUrl}}/api/rooms

> {%
  client.test("[26] Chambre désactivée absente de la liste active", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    var found = response.body.some(function (r) {
      return String(r.id) === client.global.get("id301");
    });
    client.assert(!found, "La chambre désactivée ne doit pas apparaître dans la liste active");
  });
%}

### [27] Lister les chambres désactivées
GET {{baseUrl}}/api/rooms/disabled

> {%
  client.test("[27] GET /disabled → chambre 301 présente", function () {
    client.assert(response.status === 200, "Attendu 200 OK");
    client.assert(response.body.length >= 1, "Au moins 1 chambre désactivée");
    var found = response.body.some(function (r) {
      return String(r.id) === client.global.get("id301");
    });
    client.assert(found, "La chambre 301 doit être dans /disabled");
    response.body.forEach(function (r) {
      client.assert(r.active === false, "Toutes les chambres de /disabled doivent avoir active=false");
    });
  });
%}

