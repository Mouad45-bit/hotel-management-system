# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 : Build Maven
# ─────────────────────────────────────────────────────────────────────────────
FROM maven:3.9.9-eclipse-temurin-17 AS builder

WORKDIR /app

# Copier le pom.xml en premier permet de profiter du cache Docker
# si les dépendances Maven ne changent pas.
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copier ensuite les sources et compiler l'application.
COPY src ./src
RUN mvn package -DskipTests -B


# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 : Runtime Java 17 léger
# ─────────────────────────────────────────────────────────────────────────────
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# curl est utile pour les healthchecks Docker.
# L'utilisateur non-root améliore la sécurité du conteneur.
RUN apk add --no-cache curl \
    && addgroup -S hotel \
    && adduser -S hotel -G hotel

COPY --from=builder /app/target/*.jar app.jar

RUN chown hotel:hotel app.jar

USER hotel

# Remplacer 808X par le port réel du service.
EXPOSE 808X

ENTRYPOINT ["java", "-jar", "app.jar"]
